/* InputLeap — tema claro estilo macOS
   Superfícies: janela #f5f5f7, cartões brancos, hairlines #d2d2d7.
   Acento: azul Apple #0071e3. Estados: verde #34c759, âmbar #ff9f0a, vermelho #ff3b30.
   Tipografia: fonte do sistema (San Francisco no macOS, Segoe UI no Windows).
   Raios: cartões 12px, controles 8px, botão principal em pílula. */

QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-size: 13px;
}

QMainWindow,
QDialog,
QMenuBar {
    background-color: #f5f5f7;
    color: #1d1d1f;
}

QMenuBar {
    background: #f5f5f7;
    border: none;
    border-bottom: 1px solid #d2d2d7;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    color: #1d1d1f;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: #e8e8ed;
}

QMenu {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 6px;
    color: #1d1d1f;
}

QMenu::item:selected {
    background: #0071e3;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e5e5ea;
    margin: 6px 10px;
}

#headerBar {
    background: #f5f5f7;
    border: none;
    border-bottom: 1px solid #d2d2d7;
    min-height: 56px;
}

#m_pBrandTitle {
    color: #1d1d1f;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.2px;
}

#m_pBrandMark {
    background: transparent;
}

#m_pStatusLabel {
    color: #6e6e73;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 13px;
    background: #e8e8ed;
    border: none;
}

#m_pStatusLabel[conn="live"] {
    color: #1d7a3a;
    background: #d8f5e0;
}

#m_pStatusLabel[conn="arm"] {
    color: #96590a;
    background: #ffe9c8;
}

#m_pStatusLabel[conn="off"] {
    color: #6e6e73;
    background: #e8e8ed;
}

#bodyWrap {
    background: #f5f5f7;
}

#instrumentsRow {
    background: transparent;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    margin-top: 18px;
    padding: 18px 16px 14px 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #6e6e73;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QGroupBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #c7c7cc;
    background: #ffffff;
    margin-right: 6px;
}

QGroupBox::indicator:checked {
    background: #0071e3;
    border-color: #0071e3;
}

QGroupBox:disabled {
    color: #aeaeb2;
}

#m_pGroupServer,
#m_pGroupClient {
    min-width: 300px;
}

#m_pGroupServer:checked,
#m_pGroupClient:checked {
    border: 1px solid #0071e3;
}

#m_pGroupServer:!checked,
#m_pGroupClient:!checked,
#m_pGroupServer:disabled,
#m_pGroupClient:disabled {
    background: #fbfbfd;
    border: 1px solid #e5e5ea;
}

#m_pLabelIpAddresses,
#m_pLabelScreenName {
    color: #1d1d1f;
    font-size: 14px;
    font-weight: 600;
    font-family: "SF Mono", "Menlo", "Cascadia Mono", "Consolas", monospace;
}

QLabel {
    background: transparent;
    color: #515154;
}

QRadioButton,
QCheckBox {
    spacing: 8px;
    color: #1d1d1f;
    min-height: 30px;
    background: transparent;
    border: none;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #c7c7cc;
    background: #ffffff;
}

QRadioButton::indicator:checked {
    border: 5px solid #0071e3;
    background: #ffffff;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #c7c7cc;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #0071e3;
    border-color: #0071e3;
}

QRadioButton:disabled,
QCheckBox:disabled,
QLabel:disabled {
    color: #aeaeb2;
}

QLineEdit,
QComboBox {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1d1d1f;
    selection-background-color: #b3d7ff;
    selection-color: #1d1d1f;
    min-height: 18px;
    min-width: 160px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #0071e3;
    padding: 7px 11px;
}

QLineEdit:disabled {
    background: #f5f5f7;
    color: #aeaeb2;
    border-color: #e5e5ea;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QPushButton {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 500;
    min-height: 18px;
}

QPushButton:hover {
    background: #f5f5f7;
}

QPushButton:pressed {
    background: #e8e8ed;
}

QPushButton:disabled {
    color: #aeaeb2;
    background: #f5f5f7;
    border-color: #e5e5ea;
}

QPushButton:focus {
    border: 2px solid #0071e3;
    padding: 6px 17px;
}

#m_pButtonConfigureServer {
    background: #e8f1fd;
    color: #0071e3;
    border: none;
    border-radius: 8px;
    font-weight: 600;
}

#m_pButtonConfigureServer:hover {
    background: #d8e8fb;
}

#m_pButtonReload {
    background: transparent;
    color: #0071e3;
    border: 1px solid #d2d2d7;
    border-radius: 17px;
    padding: 8px 20px;
}

#m_pButtonReload:hover {
    background: #ffffff;
}

#m_pButtonReload:disabled {
    border-color: #e5e5ea;
    color: #aeaeb2;
}

#m_pButtonToggleStart {
    background: #0071e3;
    color: #ffffff;
    border: none;
    border-radius: 17px;
    padding: 8px 26px;
    font-weight: 600;
    min-width: 104px;
}

#m_pButtonToggleStart:hover {
    background: #0077ed;
}

#m_pButtonToggleStart:pressed {
    background: #006edb;
}

#m_pButtonToggleStart[mode="stop"] {
    background: #ff3b30;
    color: #ffffff;
}

#m_pButtonToggleStart[mode="stop"]:hover {
    background: #ff4f45;
}

#footerBar {
    background: #f5f5f7;
    border: none;
    border-top: 1px solid #d2d2d7;
}

#layoutPreview {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    padding: 6px;
    min-height: 52px;
}

#m_pLayoutCaption {
    color: #6e6e73;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

#m_pLayoutLeftChip,
#m_pLayoutRightChip {
    background: #f5f5f7;
    color: #1d1d1f;
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

#m_pLayoutArrow {
    color: #0071e3;
    font-size: 17px;
    font-weight: 600;
}

#m_pGroupShare {
    background: #ffffff;
    border: 1px solid #e5e5ea;
}

#m_pLabelSharePath {
    color: #1d1d1f;
    font-size: 12px;
    font-family: "SF Mono", "Menlo", "Cascadia Mono", "Consolas", monospace;
}

#m_pLabelShareHint {
    color: #6e6e73;
    font-size: 12px;
}

#m_pLabelShareStatus {
    color: #0071e3;
    font-size: 12px;
    font-weight: 600;
}

#m_pButtonSendFile {
    background: #e8f1fd;
    color: #0071e3;
    border: none;
    font-weight: 600;
}

#m_pButtonSendFile:hover {
    background: #d8e8fb;
}

#m_pButtonOpenShare,
#m_pButtonChooseShare {
    background: transparent;
    color: #0071e3;
    border: 1px solid #d2d2d7;
}

#m_pButtonOpenShare:hover,
#m_pButtonChooseShare:hover {
    background: #ffffff;
}

#frame_fingerprint_details {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 10px;
}

#m_pLabelFingerprint,
#m_pLabelLocalFingerprint,
#label_sha256,
#label_sha1 {
    color: #6e6e73;
    font-size: 11px;
}

#label_sha256_fingerprint_full,
#label_sha1_fingerprint_full,
#label_sha256_randomart {
    color: #515154;
    font-family: "SF Mono", "Menlo", "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QToolButton {
    background: transparent;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 5px 10px;
    color: #1d1d1f;
}

QToolButton:hover {
    background: #ffffff;
}

QTabWidget::pane {
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6e6e73;
    padding: 8px 18px;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0071e3;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #c7c7cc;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #aeaeb2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #c7c7cc;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QMessageBox,
QDialog {
    background: #f5f5f7;
}

QPlainTextEdit,
QTextEdit {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    color: #1d1d1f;
    selection-background-color: #b3d7ff;
}

QHeaderView::section {
    background: #f5f5f7;
    color: #6e6e73;
    border: none;
    border-bottom: 1px solid #e5e5ea;
    padding: 8px 10px;
    font-weight: 600;
}

QToolTip {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 4px 8px;
}
